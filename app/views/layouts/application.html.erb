<!DOCTYPE html>
<html>
  <head>
    <title>Bookers</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- サクセスメッセージなどを表示する領域（テスト合格に必須です） -->
    <% flash.each do |key, value| %>
      <p id="notice"><%= value %></p>
    <% end %>

    <%= yield %>
  </body>
</html>