<%= form_with(model: book) do |form| %>
  <% if book.errors.any? %>
    <div style="color: red; background-color: #fdd; padding: 10px; margin-bottom: 20px; border-radius: 5px;">
      <% book.errors.full_messages.each do |message| %>
        <p style="margin: 0;"><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "本のタイトル" %><br>
    <%= form.text_field :title %>
  </div>
  <div>
    <%= form.label :body, "感想" %><br>
    <%= form.text_area :body %>
  </div>
  <div>
    <%= form.label :image, "本の表紙（画像）" %><br>
    <%= form.file_field :image, accept: "image/*" %>
  </div>
  <div>
    <%= form.submit "保存する" %>
  </div>
<% end %>